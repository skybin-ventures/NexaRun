<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaRun.Tray.ViewModels"
        x:Class="NexaRun.Tray.Views.DashboardWindow"
        Title="NexaRun — Dashboard"
        Width="900" Height="600"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Header -->
    <Border DockPanel.Dock="Top"
            Background="#1a1a2e" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="NexaRun Dashboard"
                     FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Classes="statusMuted"
                     VerticalAlignment="Center" FontSize="13" Foreground="#f97316"/>
        </StackPanel>
        <Button x:Name="RefreshBtn" Grid.Column="1" Padding="10,4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="14" Height="14" Data="{StaticResource ToolbarIconRefresh}" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Main split: left process list, right detail panel -->
    <Grid ColumnDefinitions="220,4,*">

      <!-- Process list -->
      <Border Background="#0f0f1a" BorderBrush="#2a2a4a" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="PROCESSES" FontSize="11" FontWeight="Bold"
                     Foreground="#9ca3af" Margin="12,10,12,6"
                     LetterSpacing="1.5"/>
          <TextBlock x:Name="EmptyListText" DockPanel.Dock="Bottom"
                     Text="No processes yet. Add one from the Processes window."
                     Foreground="#9ca3af" FontSize="12" TextWrapping="Wrap"
                     Margin="12,8" IsVisible="False"/>
          <ListBox x:Name="ProcessList"
                   Background="Transparent"
                   SelectionMode="Single">
            <ListBox.Styles>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="#2a2a4a" />
              </Style>
              <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#3a3a5a" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DashboardProcessItem">
                <Grid ColumnDefinitions="8,*" Margin="4,2"
                      ToolTip.Tip="{Binding StatusTooltip}">
                  <Ellipse Grid.Column="0" Width="8" Height="8"
                           Fill="{Binding StatusBrush}"
                           VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Medium" FontSize="13"/>
                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="11" Foreground="#9ca3af"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1" Width="4" Background="#1e1e3a"
                    ResizeDirection="Columns"/>

      <!-- Detail panel -->
      <DockPanel Grid.Column="2">

        <!-- Stats bar for selected process -->
        <Border DockPanel.Dock="Top"
                Background="#111128" Padding="16,10"
                BorderBrush="#2a2a4a" BorderThickness="0,0,0,1"
                x:Name="StatsBar" IsVisible="False">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,*,*,*">
              <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                <TextBlock Text="STATUS" FontSize="10" Foreground="#9ca3af" FontWeight="Bold" LetterSpacing="1"/>
                <TextBlock x:Name="DetailStatus" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailReason" FontSize="12" Foreground="#fca5a5"
                           TextWrapping="Wrap" IsVisible="False"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="PID" FontSize="10" Foreground="#9ca3af" FontWeight="Bold" LetterSpacing="1"/>
                <TextBlock x:Name="DetailPid" FontSize="14" Foreground="#d1d5db"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="MEMORY" FontSize="10" Foreground="#9ca3af" FontWeight="Bold" LetterSpacing="1"/>
                <TextBlock x:Name="DetailMemory" FontSize="14" Foreground="#d1d5db"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="2">
                <TextBlock Text="RESTARTS" FontSize="10" Foreground="#9ca3af" FontWeight="Bold" LetterSpacing="1"/>
                <TextBlock x:Name="DetailRestarts" FontSize="14" Foreground="#d1d5db"/>
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="RestartBtn" Content="Restart" Padding="12,4" IsEnabled="False"/>
              <Button x:Name="OpenUrlBtn" Content="Open URL" Padding="12,4" IsEnabled="False"/>
              <Button x:Name="LogsBtn" Content="Logs" Padding="12,4" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Detail tabs -->
        <StackPanel DockPanel.Dock="Top" x:Name="DetailTabs" IsVisible="False"
                    Orientation="Horizontal" Spacing="6" Margin="16,8,16,0">
          <Button x:Name="HistoryTabBtn" Content="Run history" Classes="tab active" />
          <Button x:Name="LogsTabBtn" Content="Logs" Classes="tab" />
        </StackPanel>

        <!-- Process logs (same window) -->
        <DockPanel x:Name="LogsPanel" IsVisible="False" Margin="0,0,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                      Spacing="8" Margin="16,8,16,8">
            <TextBlock x:Name="LogsTitle" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button x:Name="LogsRefreshBtn" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="14" Height="14" Data="{StaticResource ToolbarIconRefresh}" />
                <TextBlock Text="Refresh" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="LogsClearBtn" Content="Clear Log" Classes="danger" Padding="10,4" />
            <CheckBox x:Name="LogsAutoScrollBox" Content="Auto-scroll"
                      IsChecked="True" VerticalAlignment="Center"/>
            <CheckBox x:Name="LogsLiveBox" Content="Live update"
                      IsChecked="True" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="LogsErrorBanner" DockPanel.Dock="Top" Classes="errorText"
                     IsVisible="False" Margin="16,0,16,8" />
          <Border Margin="16,0,16,16" Background="#0a0a18"
                  BorderBrush="#2a2a4a" BorderThickness="1" CornerRadius="4">
            <ScrollViewer x:Name="LogsScroller">
              <TextBox x:Name="LogsBox"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       FontFamily="Consolas,Menlo,monospace"
                       FontSize="12"
                       TextWrapping="NoWrap"
                       Background="#1e1e1e"
                       Foreground="#d4d4d4"
                       BorderThickness="0"
                       Padding="8"
                       AutomationProperties.Name="Process log output"/>
            </ScrollViewer>
          </Border>
        </DockPanel>

        <!-- Run history section -->
        <DockPanel x:Name="HistoryPanel" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                      Spacing="8" Margin="16,10,16,8">
            <TextBlock x:Name="HistoryTitle"
                       FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="— last 7 days (updates on Refresh)" FontSize="12" Foreground="#9ca3af"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- 7-day uptime bar chart -->
          <Border DockPanel.Dock="Top"
                  Background="#0a0a18" Margin="16,0,16,12"
                  Padding="10,8" CornerRadius="4"
                  BorderBrush="#2a2a4a" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="UPTIME — PAST 7 DAYS"
                         FontSize="10" Foreground="#9ca3af" FontWeight="Bold" LetterSpacing="1"
                         Margin="0,0,0,4"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="UptimeBars">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="3"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UptimeDayBar">
                      <StackPanel Spacing="3" Width="72" MinWidth="48">
                        <Border Height="40" Background="#1e1e3a"
                                CornerRadius="2" ClipToBounds="True"
                                ToolTip.Tip="{Binding UptimePct}">
                          <Border VerticalAlignment="Bottom"
                                  Height="{Binding BarHeight}"
                                  Background="{Binding BarColor}"
                                  CornerRadius="2"/>
                        </Border>
                        <TextBlock Text="{Binding DayLabel}"
                                   FontSize="10" Foreground="#9ca3af"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding UptimePct}"
                                   FontSize="10" Foreground="#d1d5db"
                                   HorizontalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- Run history grid -->
          <DataGrid x:Name="RunGrid"
                    x:CompileBindings="False"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    Background="Transparent"
                    Margin="16,0,16,16">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Started"    Binding="{Binding StartedLabel}" Width="*" MinWidth="120"/>
              <DataGridTextColumn Header="Duration"   Binding="{Binding DurationLabel}" Width="Auto"/>
              <DataGridTextColumn Header="Outcome"    Binding="{Binding OutcomeLabel}"  Width="Auto"/>
              <DataGridTextColumn Header="Exit Code"  Binding="{Binding ExitCodeLabel}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText"
                   Text="Select a process to view run history or logs"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#9ca3af" FontSize="14"/>

      </DockPanel>
    </Grid>

  </DockPanel>
</Window>
